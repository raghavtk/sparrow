{
  "name": "sparrow",
  "version": "1.0.0",
  "description": "Sparrow: Node.js health monitor for authorized video streaming websites",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --sites sites.txt --db results.db",
    "check": "node src/index.js --sites sites.txt --db results.db --headless true",
    "server": "node server.js",
    "dev": "concurrently -n API,UI -c cyan,magenta \"node server.js\" \"cd frontend && npm run dev\"",
    "test": "node --test --test-concurrency=1 tests/functionality.test.mjs",
    "build": "npm --prefix frontend run build",
    "format": "prettier --write server.js src frontend/src tests/*.mjs tests/assets/README.md README.md compose.yaml package.json",
    "pretest": "npm run build",
    "security:tls": "node scripts/check-tls.mjs"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "playwright": "^1.64.1",
    "puppeteer": "^25.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  }
}
